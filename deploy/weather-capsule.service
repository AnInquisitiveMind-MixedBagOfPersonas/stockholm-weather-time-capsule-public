[Unit]
Description=Stockholm Weather Time Capsule
After=network.target

[Service]
User=weather-capsule
Group=weather-capsule
WorkingDirectory=/opt/weather-capsule
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/weather-capsule/.venv/bin/waitress-serve --listen=127.0.0.1:8000 --threads=2 --connection-limit=32 --channel-timeout=15 --cleanup-interval=5 --max-request-header-size=8192 --max-request-body-size=1024 wsgi:application
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=multi-user.target
